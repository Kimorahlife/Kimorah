{
  "name": "kimorah-server",
  "version": "1.0.0",
  "private": true,
  "main": "dist/index.js",
  "type": "commonjs",
  "engines": {
    "node": ">=20 <23"
  },
  "scripts": {
    "predev": "node scripts/free-port.cjs",
    "dev": "dotenv -e .env.development.local -- tsx watch src/index.ts",
    "build": "tsc -p tsconfig.backend.json",
    "content:session-four": "dotenv -e .env.development.local -- tsx src/scripts/upsert-session-four.ts",
    "content:sessions-five-seven": "dotenv -e .env.development.local -- tsx src/scripts/upsert-sessions-five-seven.ts",
    "content:session-presentations": "dotenv -e .env.development.local -- tsx src/scripts/backfill-session-presentations.ts",
    "content:psychoeducation-icons": "dotenv -e .env.development.local -- tsx src/scripts/backfill-psychoeducation-icons.ts",
    "content:when-love-remains": "dotenv -e .env.development.local -- tsx src/scripts/import-when-love-remains-sessions.ts",
    "content:psychoeducation-layout": "dotenv -e .env.development.local -- tsx src/scripts/backfill-psychoeducation-layout.ts",
    "content:professional-affirmations": "dotenv -e .env.development.local -- tsx src/scripts/seed-professional-affirmations.ts",
    "postbuild": "node scripts/copy-config.cjs",
    "start": "node dist/index.js"
  },
  "author": "Carlos Guisao",
  "license": "ISC",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.116.0",
    "bcrypt": "^5.1.1",
    "body-parser": "^1.20.3",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.12.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/body-parser": "^1.19.5",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.1",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/node": "^22.18.1",
    "dotenv-cli": "^10.0.0",
    "prettier": "^3.5.3",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
